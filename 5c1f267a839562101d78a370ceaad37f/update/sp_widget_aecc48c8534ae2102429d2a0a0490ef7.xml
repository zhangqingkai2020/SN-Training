      <th>Number</th>
      <th>Short Description</th>
      <th>State</th>
      <th>Opened</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <tr ng-repeat="item in data.items">
      <td>{{ item.number }}</td>
      <td>{{ item.short_description }}</td>
      <td>{{ item.state }}</td>
      <td>{{ item.opened_at }}</td>
      <td>
        <a href="/sp?id=sc_cat_item&sys_id={{ item.cat_item }}&sysparm_ritm_id={{ item.sys_id }}">Resubmit</a>
      </td>
    </tr>
  </tbody>
</table>]]></template>
